{
  "name": "thunders-generative-ai",
  "version": "0.1.0",
  "private": true,
  "description": "⚡ Monorepo for the Thunders Generative AI platform — text, image, video, audio and code generation.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "format": "pnpm -r --if-present format"
  }
}
